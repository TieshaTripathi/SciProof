WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SECURE_COOKIES=false
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sciproof:sciproof@localhost:5432/sciproof
REDIS_URL=redis://localhost:6379/0
VERIFICATION_MODE=celery
POSTGRES_PASSWORD=replace-with-local-password
REDIS_PASSWORD=replace-with-local-redis-password
# Supply a Fernet key in production. Never commit the real key.
# STORAGE_ENCRYPTION_KEY=

# Optional semantic gateway. Disabled by default; no deterministic values are overwritten.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_MODEL=
AI_ENDPOINT=
AI_TIMEOUT_SECONDS=10
AI_ALLOW_PRIVATE=false
# AI_API_TOKEN=

STORAGE_BACKEND=local_encrypted
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
IPFS_ENABLED=false
IPFS_PROVIDER=pinata
# PINATA_JWT=

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_PROVIDER=evm
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=3
# BLOCKCHAIN_PRIVATE_KEY=

# TASK_SIGNING_KEY= (optional separate 32+ character key; otherwise derived from storage key)
